POSTGRES_USER=envira
POSTGRES_PASSWORD=envira
POSTGRES_DB=envira
# Used by local tests (uv run --env-file); the core container overrides the host to `db`.
DATABASE_URL=postgresql+psycopg://envira:envira@localhost:5432/envira
# CSV folder, relative to core/ for local tests; the core container overrides it to /data.
DATA_DIR=../data
